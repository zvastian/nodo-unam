// Configuración de pruebas/puerta.test.mjs y pruebas/estres.mjs, en el CI y en local: la del Worker
// sin el binding de IA (pide una cuenta de Cloudflare, que el CI no tiene) y con la IA apagada,
// contra el servicio simulado (pruebas/servicio_simulado.mjs, en :8770). La fila de verdad: 2 a la vez.
// Los secretos salen de pruebas/.dev.vars (copia de .dev.vars; ignorada por git).
//   npx wrangler dev -c pruebas/wrangler.ci.jsonc --persist-to .wrangler/state --port 8787 --ip 127.0.0.1
{
  "name": "nodos-puerta",
  "main": "../src/index.js",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "nodos", "database_id": "local-nodos", "migrations_dir": "../migrations" }
  ],
  "ratelimits": [
    { "name": "LIMITE_IP", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "LIMITE_IP_LAB", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "LIMITE_USUARIO", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } }
  ],
  "durable_objects": { "bindings": [{ "name": "FILA", "class_name": "Fila" }] },
  "migrations": [{ "tag": "fila-v1", "new_sqlite_classes": ["Fila"] }],
  "vars": {
    "ENTORNO": "local",
    "FILA_SIMULTANEOS": "2",
    "TOPE_MES": "100000",
    "TURNSTILE_HOSTS": "",
    "ORIGENES": "http://127.0.0.1:8765,http://localhost:8765",
    "LAB_URL": "http://127.0.0.1:8770",
    "SUPABASE_URL": "https://vujmkcpxsdrmrwsijnlz.supabase.co",
    "JWT_EMISOR": "",
    "CUOTA_USUARIO_DIA": "2",
    "TOPE_SITIO_DIA": "100000",
    "MAX_ANALISIS_GUARDADOS": "2",
    "MAX_TESIS_GUARDADAS": "500",
    "MAX_ASESORES_GUARDADOS": "200",
    "MAX_LUGARES_GUARDADOS": "200",
    "TOPE_IA_DIA": "0"
  }
}
